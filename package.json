{
  "name": "code-canvas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,mjs,cjs,ts,tsx,mts,cts,json,css,glsl,yml,yaml}": [
      "prettier --check --ignore-unknown"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck && pnpm baseline:guard"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "fixtures": "tsx fixtures/generate.ts",
    "baseline:guard": "node --import tsx/esm scripts/guard-baseline.ts",
    "baseline:guard:ci": "node --import tsx/esm scripts/guard-baseline.ts --ci",
    "check": "pnpm typecheck && pnpm lint && pnpm check-max-lines && pnpm format:check && pnpm knip && pnpm test",
    "check-max-lines": "node --import tsx/esm scripts/check-max-lines.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "perf": "node --import tsx/esm perf/harness/cli.ts run",
    "perf:quick": "node --import tsx/esm perf/harness/cli.ts run --quick",
    "perf:stages": "node --import tsx/esm perf/harness/cli.ts stages",
    "perf:self-test": "node --import tsx/esm perf/harness/cli.ts self-test",
    "perf:baseline": "node --import tsx/esm perf/harness/cli.ts baseline:update",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "simple-git-hooks",
    "validate": "pnpm check",
    "typecheck": "tsc --noEmit && tsc -p spikes/tsconfig.json --noEmit && tsc -p tsconfig.domain.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@paulirish/trace_engine": "^0.0.65",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-import-x": "^4.16.1",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.1",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.11.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.2",
    "vitest": "^3.2.4",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0",
    "tm-grammars": "^1.32.22",
    "tm-themes": "^1.12.12",
    "twgl.js": "^7.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
